{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KTLauncherProvidersConfig",
  "type": "object",
  "required": ["version", "canonicalRepo", "endpoints"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "canonicalRepo": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$" },
    "endpoints": {
      "type": "object",
      "required": ["updates", "agent", "servers", "news", "libraryPatches"],
      "additionalProperties": false,
      "properties": {
        "updates": {
          "type": "object",
          "required": ["githubReleases", "userAgent", "timeoutMs", "maxRetries"],
          "additionalProperties": false,
          "properties": {
            "githubReleases": { "type": "string", "format": "uri", "pattern": "^https://api\\.github\\.com/" },
            "userAgent": { "type": "string" },
            "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 30000 },
            "maxRetries": { "type": "integer", "minimum": 0, "maximum": 5 }
          }
        },
        "agent": {
          "type": "object",
          "required": ["filename", "signatureFilename", "expectedSha256", "publisherPublicKey"],
          "additionalProperties": false,
          "properties": {
            "filename": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+\\.jar$" },
            "signatureFilename": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+\\.sig$" },
            "expectedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "publisherPublicKey": { "type": "string" }
          }
        },
        "servers": {
          "type": "object",
          "required": ["communityListUrl", "timeoutMs", "fallbackServers"],
          "additionalProperties": false,
          "properties": {
            "communityListUrl": { "type": "string", "format": "uri" },
            "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 30000 },
            "fallbackServers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name", "address", "version", "description", "category"],
                "properties": {
                  "id": { "type": "integer" },
                  "name": { "type": "string" },
                  "address": { "type": "string" },
                  "version": { "type": "string" },
                  "description": { "type": "string" },
                  "category": { "type": "string" },
                  "online": { "type": "boolean" },
                  "players": { "type": "object" },
                  "ping": { "type": "integer" }
                }
              }
            }
          }
        },
        "news": {
          "type": "object",
          "required": ["feedUrl", "fallbackNews"],
          "additionalProperties": false,
          "properties": {
            "feedUrl": { "type": "string", "format": "uri" },
            "fallbackNews": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title", "summary", "url", "published_at"],
                "properties": {
                  "id": { "type": "integer" },
                  "title": { "type": "string" },
                  "summary": { "type": "string" },
                  "url": { "type": "string" },
                  "published_at": { "type": "string" }
                }
              }
            }
          }
        },
        "libraryPatches": {
          "type": "object",
          "required": ["localOnly", "manifest"],
          "additionalProperties": false,
          "properties": {
            "localOnly": { "type": "boolean" },
            "manifest": { "type": "string" }
          }
        }
      }
    }
  }
}
